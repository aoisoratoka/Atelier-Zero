---
const projects = [
    {
        number: "01",
        name: "Kana",
        description:
            "A highly personalised Linux desktop shell, built with Quickshell, Qt and C++. It combines all of my favourite packages in one single shell.",
        status: "IN DEVELOPMENT",
        href: "#kana",
    },
];

const journal = [
    {
        number: "001",
        title: "The beginning of something.",
        category: "NOTES",
        date: "NOV 2026",
    },
];
---

<!doctype html>
<html lang="en">
    <head>
        <meta charset="UTF-8" />
        <meta name="viewport" content="width=device-width, initial-scale=1" />
        <meta name="theme-color" content="#eae7df" />
        <meta
            name="description"
            content="Atelier-Zero — A personal space for engineering, software, experiments and thoughts."
        />
        <link rel="preconnect" href="https://fonts.googleapis.com" />
        <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
        <link
            href="https://fonts.googleapis.com/css2?family=Bodoni+Moda:ital,wght@0,400;0,500;1,400;1,500&display=swap"
            rel="stylesheet"
        />
        <title>Atelier Zero</title>
    </head>

    <body>
        <header class="navigation">
            <a class="wordmark" href="/" aria-label="Atelier-Zero home">
                ATELIER<span>—</span>ZERO<span class="period">.</span>
            </a>

            <nav aria-label="Main navigation">
                <a href="#work">Projects</a>
                <a href="#journal">Journal</a>
                <a href="#about">About</a>
            </nav>
        </header>

        <main>
            <section class="hero">
                <div class="hero-content">
                    <p class="eyebrow">DREAMING A SIMPLE DREAM</p>

                    <h1>
                        Atelier <em>Zero</em>
                    </h1>

                    <div class="hero-bottom">
                        <p class="hero-description">
                            Creating what had always been a dream to me.
                        </p>

                        <a class="text-link" href="#about">
                            A LITTLE ABOUT ME <span>↗</span>
                        </a>
                    </div>
                </div>

                <div class="hero-index">
                    <span>MADE WITH DEPENDANCE</span>
                    <span>001 — ∞</span>
                </div>
            </section>

            <section class="work section" id="work">
                <div class="section-heading">
                    <div>
                        <h2>
                            Curent <em>Endeavours</em>
                        </h2>
                    </div>
                </div>

                {projects.map((project) => (
                    <article class="project-card" id="kana">
                        <div class="project-number">{project.number}</div>

                        <div class="project-info">
                            <div class="project-topline">
                                <span>{project.status}</span>
                            </div>

                            <h3>
                                {project.name}
                                <span>.</span>
                            </h3>
                            <p>{project.description}</p>
                            <a href={project.href} class="text-link">
                                EXPLORE PROJECT <span>↗</span>
                            </a>
                        </div>

                        <div class="project-visual" aria-hidden="true">
                            <span class="visual-symbol">奏</span>
                            <span class="visual-caption">
                                A SYSTEM OF MY OWN
                            </span>
                        </div>
                    </article>
                ))}
            </section>

            <section class="journal section" id="journal">
                <div class="section-heading">
                    <div>
                        <p class="eyebrow">02 / THE JOURNAL</p>
                        <h2>
                            Notes from the <em>process.</em>
                        </h2>
                    </div>
                    <span class="section-note">
                        THOUGHTS, LOGS & DISCOVERIES.
                    </span>
                </div>

                {journal.map((entry) => (
                    <article class="journal-entry">
                        <span class="entry-number">{entry.number}</span>

                        <div class="entry-main">
                            <div class="entry-meta">
                                <span>{entry.category}</span>
                                <span>{entry.date}</span>
                            </div>
                            <h3>{entry.title}</h3>
                        </div>

                        <span class="entry-arrow" aria-hidden="true">
                            ↗
                        </span>
                    </article>
                ))}
            </section>

            <section class="about section" id="about">
                <p class="eyebrow">03 / A LITTLE ABOUT ME</p>

                <div class="about-content">
                    <h2>
                        Curious by nature.
                        <br />
                        <em>Driven by possibilities.</em>
                    </h2>

                    <p>
                        I'm on a journey to create all the stuff that I had only
                        ever dreamed of. Be it a linux desktop shell, a game, or
                        something else. Let's build together, one mistake at a
                        tiime.
                    </p>
                </div>
            </section>
        </main>
    </body>
</html>

<style>
    :root {
        font-family: "Inter", "Helvetica Neue", sans-serif;
        color: #25241f;
        background: #eae7df;
        font-synthesis: none;
        text-rendering: optimizeLegibility;
        -webkit-font-smoothing: antialiased;
        -moz-osx-font-smoothing: grayscale;

        --paper: #eae7df;
        --ink: #25241f;
        --muted: #89857c;
        --line: #cfcbc1;
        --accent: #a76d4e;
        --serif: "Bodoni Moda", serif;
        --mono: "JetBrains Mono", "SFMono-Regular", Consolas, monospace;
    }

    * {
        box-sizing: border-box;
    }

    html {
        scroll-behavior: smooth;
    }

    body {
        margin: 0;
        min-width: 320px;
    }

    a {
        color: inherit;
        text-decoration: none;
    }

    .navigation {
        min-height: 76px;
        padding: 0 7%;
        display: flex;
        align-items: center;
        justify-content: space-between;
        border-bottom: 1px solid var(--line);
    }

    .wordmark {
        font-size: 16px;
        font-weight: 750;
        letter-spacing: -0.9px;
    }

    .wordmark > span:first-child,
    .period {
        color: var(--accent);
    }

    nav {
        display: flex;
        gap: 34px;
    }

    nav a {
        font-size: 12px;
        color: #68645c;
        transition: color 180ms ease;
    }

    nav a:hover {
        color: var(--accent);
    }

    .availability,
    .eyebrow,
    .hero-meta,
    .hero-index,
    .section-note,
    .project-topline,
    .project-number,
    .text-link,
    .visual-caption,
    .entry-number,
    .entry-meta,
    .footer > span {
        font-family: var(--mono);
        font-size: 9px;
        letter-spacing: 0.09em;
    }

    .availability {
        display: flex;
        align-items: center;
        gap: 8px;
        color: var(--muted);
    }

    .status-dot {
        width: 6px;
        height: 6px;
        border-radius: 50%;
        background: #82916c;
    }

    .hero {
        padding: 25px 7% 30px;
        min-height: 590px;
        display: flex;
        flex-direction: column;
        justify-content: space-between;
    }

    .hero-meta,
    .hero-index {
        display: flex;
        justify-content: space-between;
        color: var(--muted);
    }

    .hero-content {
        max-width: 950px;
        margin: 110px auto 65px;
        width: 100%;
    }

    .hero .eyebrow {
        color: var(--accent);
        margin-bottom: 28px;
    }

    h1,
    h2 {
        font-family: var(--serif);
        font-weight: 400;
        letter-spacing: -0.065em;
    }

    h1 {
        font-size: clamp(58px, 9vw, 112px);
        line-height: 1.05;
        margin: 0;
    }

    h1 em,
    h2 em {
        color: var(--accent);
        font-weight: 400;
    }

    .hero-bottom {
        margin-top: 38px;
        display: flex;
        align-items: flex-end;
        justify-content: space-between;
        gap: 30px;
        flex-direction: row;
        text-align: left;
    }

    .hero-description,
    .project-info > p,
    .entry-main > p,
    .about-content > p {
        color: #77736b;
        font-size: 13px;
        line-height: 1.9;
    }

    .hero-description {
        max-width: 390px;
        margin: 0;
        color: #77736b;
        font-size: 13px;
        line-height: 1.9;
    }

    .text-link {
        display: inline-flex;
        align-items: center;
        gap: 15px;
        padding-bottom: 7px;
        border-bottom: 1px solid var(--accent);
        color: var(--ink);
        white-space: nowrap;
        transition: gap 180ms ease;
    }

    .text-link:hover {
        gap: 23px;
    }

    .text-link span {
        color: var(--accent);
        font-size: 14px;
    }

    .section {
        padding: 95px 7%;
        border-top: 1px solid var(--line);
    }

    .section-heading {
        display: flex;
        justify-content: space-between;
        align-items: flex-end;
        gap: 20px;
        margin-bottom: 55px;
    }

    h2 {
        font-size: clamp(38px, 5vw, 58px);
        line-height: 1.1;
        margin: 0;
    }

    .section-heading .eyebrow {
        margin-bottom: 17px;
    }

    .section-note {
        color: var(--muted);
        padding-bottom: 8px;
    }

    .project-card {
        display: grid;
        grid-template-columns: 60px 1fr 0.85fr;
        gap: 25px;
        padding: 35px 0;
        border-top: 1px solid var(--line);
        border-bottom: 1px solid var(--line);
    }

    .project-number {
        color: var(--accent);
        padding-top: 5px;
    }

    .project-topline,
    .entry-meta {
        display: flex;
        gap: 20px;
        color: var(--muted);
    }

    .project-info h3 {
        font-family: var(--serif);
        font-weight: 400;
        font-size: 44px;
        letter-spacing: -0.05em;
        margin: 22px 0 5px;
    }

    .project-info h3 span {
        color: var(--accent);
    }

    .project-info > p {
        max-width: 340px;
        margin-bottom: 28px;
    }

    .project-visual {
        min-height: 220px;
        background: #292923;
        color: var(--paper);
        display: flex;
        align-items: center;
        justify-content: center;
        flex-direction: column;
        position: relative;
        overflow: hidden;
    }

    .visual-symbol {
        font-family: var(--serif);
        font-size: 100px;
        color: #d3a183;
        font-style: italic;
    }

    .visual-caption {
        position: absolute;
        bottom: 16px;
        right: 16px;
        color: #a9a69d;
    }

    .journal-entry {
        display: grid;
        grid-template-columns: 60px 1fr 30px;
        gap: 25px;
        padding: 30px 0;
        border-top: 1px solid var(--line);
        align-items: start;
    }

    .entry-number,
    .entry-arrow {
        color: var(--accent);
    }

    .entry-main h3 {
        font-family: var(--serif);
        font-size: 29px;
        font-weight: 400;
        margin: 16px 0 5px;
    }

    .entry-main > p {
        margin: 0;
        max-width: 540px;
    }

    .entry-arrow {
        font-size: 20px;
    }

    .about {
        background: #dedad0;
    }

    .about-content {
        display: grid;
        grid-template-columns: 1.2fr 0.8fr;
        gap: 60px;
        align-items: end;
    }

    .about-content h2 {
        font-size: clamp(40px, 6vw, 72px);
    }

    section.about .about-content > p {
        max-width: 400px;
        margin: 0 0 5px;
        position: relative;
        top: -50px;
    }

    .footer {
        min-height: 95px;
        padding: 25px 7%;
        display: flex;
        justify-content: space-between;
        align-items: center;
        gap: 20px;
    }

    .footer > span {
        color: var(--muted);
    }

    @media (max-width: 700px) {
        .navigation {
            padding: 20px 6%;
            flex-wrap: wrap;
            gap: 20px;
        }

        nav {
            gap: 20px;
        }

        .availability {
            display: none;
        }

        .hero {
            min-height: 530px;
            padding: 24px 6%;
        }

        .hero-content {
            margin: 65px auto;
        }

        .hero-bottom,
        .section-heading {
            align-items: flex-start;
            flex-direction: column;
        }

        .section {
            padding: 70px 6%;
        }

        .project-card {
            grid-template-columns: 35px 1fr;
        }

        .project-visual {
            grid-column: 2;
            min-height: 180px;
        }

        .journal-entry {
            grid-template-columns: 35px 1fr 20px;
            gap: 12px;
        }

        .about-content {
            grid-template-columns: 1fr;
            gap: 25px;
        }

        .footer {
            padding: 25px 6%;
            flex-wrap: wrap;
        }

        .footer > span:nth-child(2) {
            display: none;
        }
    }

    @media (prefers-reduced-motion: reduce) {
        *,
        *::before,
        *::after {
            scroll-behavior: auto !important;
            transition-duration: 0.01ms !important;
        }
    }
</style>
